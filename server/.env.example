DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=agrisl
JWT_SECRET=your_secret_here

# AI provider: openai | gemini | groq
AI_PROVIDER=gemini

# Free key (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Free key: https://console.groq.com/keys  (chatbot only — no vision)
GROQ_API_KEY=

# Paid: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# PlantNet plant-species identification (free) — grounds disease detection by
# identifying the plant before the AI diagnoses it. Get a key at https://my.plantnet.org
# Optional: if unset, disease detection falls back to AI-only analysis.
PLANTNET_API_KEY=

# Kindwise crop.health — PRIMARY crop-disease detector (purpose-built ML; its own
# free quota, so it bypasses Gemini's vision rate limits). Get a key at
# https://admin.kindwise.com (crop.health product).
CROP_HEALTH_API_KEY=

# Custom-trained MobileNetV2 / Python ML microservice (Detector C).
# Run ml/serve.py (see DISEASE_DETECTION_ML.md) then set this to http://localhost:8000.
# Leave blank (default) to use the crop.health → GPT-4o Vision fallback chain.
DISEASE_MODEL_URL=

PORT=5000
