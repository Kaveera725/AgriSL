# =============================================================================
# AgriSL - Git Ignore Configuration
# =============================================================================

# Dataset — never commit to repo
AgriSL_Dataset/
data_raw/
dataset/
datasets/
server/ml/model/
server/uploads/
server/uploads/certifications/
uploads/
!server/uploads/.gitkeep
!uploads/.gitkeep

# ML model files — too large for Git
*.bin
*.h5
*.keras
*.tflite
*.pt
*.pth
*.onnx
*.pkl
*.pickle
*.joblib
*.safetensors
model.json
class_names.json
!ml-service/model/class_names.json
models/
checkpoints/

# Node modules
node_modules/
client/node_modules/
server/node_modules/
jspm_packages/
web_modules/

# Environment files
.env
.env.*
*.env
server/.env
client/.env
!.env.example
!.env.template

# Keys & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Build & Distribution Outputs
dist/
dist-ssr/
build/
out/
.next/

# Python & Virtual Environments (ML Microservice / Scripts)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
