# ============================================================
# AgriSL ML Service (Python / FastAPI) .gitignore
# ============================================================

# ── Python bytecode ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
ENV/
env/
.env/

# ── Environment / secrets ────────────────────────────────────
.env
.env.*
!.env.example

# ── Distribution / packaging ─────────────────────────────────
*.egg
*.egg-info/
dist/
build/
eggs/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── ML model weights & checkpoints ──────────────────────────
model/weights/
model/checkpoints/
*.h5
*.keras
*.pt
*.pth
*.onnx
*.tflite
*.pkl
*.joblib
*.model
*.bin

# ── ML experiment tracking ───────────────────────────────────
mlruns/
.mlflow/
wandb/
runs/

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Datasets & Training Images / Archives ───────────────────
dataset/
datasets/
train/
**/train/**
train.zip
*.zip
train.jpg
train.JPG
*train*.jpg
*train*.JPG

# ── Testing / coverage ───────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ── Type checking ────────────────────────────────────────────
.mypy_cache/
.pytype/
.pyre/

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor / IDE ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ── Misc ─────────────────────────────────────────────────────
*.tmp
*.temp
.cache/
