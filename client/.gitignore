# ============================================================
# AgriSL Client (Vite + React) .gitignore
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Build outputs ────────────────────────────────────────────
dist/
dist-ssr/

# ── Environment / secrets ────────────────────────────────────
.env
.env.*
!.env.example
*.local

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing / coverage ───────────────────────────────────────
coverage/
.nyc_output/

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor / IDE ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Vite cache ───────────────────────────────────────────────
.vite/
